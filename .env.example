# Copia este archivo como .env y pega tu API key de Anthropic.
# El archivo .env es privado: no lo compartas ni lo subas a un repositorio.
ANTHROPIC_API_KEY=

# Modelo de IA (opciones: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-4-5)
IA_MODELO=claude-opus-5-5
# Esfuerzo de razonamiento: low, medium, high, xhigh o max
IA_EFFORT=low
# Confianza mínima (0 a 1) para que un "exacto" de la IA cuente como Exacto; si no, queda como Similar
IA_CONFIANZA_EXACTO=0.90

# Solo para subir el estado inicial a GitHub (python -m comparador.github_datos subir-estado)
GITHUB_REPO=usuario/comparador-precios
GITHUB_TOKEN=
